# Minimax M3 API 配置
# 从 https://platform.minimaxi.com 获取 API Key
MINIMAX_API_KEY=your-api-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# LLM 提供方：minimax 或 qwen
LLM_PROVIDER=minimax

# LLM 单次调用最大输出 token 数（默认 4096；过小会导致长 JSON 输出被截断）
LLM_MAX_TOKENS=4096

# 知识库向量嵌入（MiniMax embo-01，1536 维；不配置则语义检索关闭，退回纯关键词）
MINIMAX_GROUP_ID=your-group-id-here
EMBEDDING_MODEL=embo-01
EMBEDDING_DIM=1536

# 数据库路径（默认 SQLite）
DATABASE_URL=sqlite:///./phishing_detector.db

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 数据集存放目录（相对于项目根目录）
DATA_DIR=./data

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
